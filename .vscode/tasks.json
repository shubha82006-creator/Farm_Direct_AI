{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Farm Direct AI Server",
            "type": "shell",
            "command": "python -m uvicorn app:app --reload --host 127.0.0.1 --port 8000",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            }
        },
        {
            "label": "Open Farm Direct AI in Browser",
            "type": "shell",
            "command": "start http://127.0.0.1:8000",
            "problemMatcher": []
        }
    ]
}
